# https://my.telegram.org -> API development tools
TGADS_TG_API_ID=
TGADS_TG_API_HASH=

# Panel access (set a password on a VPS!)
TGADS_HOST=127.0.0.1
TGADS_PORT=8080
TGADS_PANEL_USER=admin
TGADS_PANEL_PASSWORD=

# AI: auto | claude_cli | api | manual
#   claude_cli — local Claude Code logged into your Claude subscription (no API key)
#   manual     — copy prompts into a Claude chat and paste answers back
TGADS_AI_MODE=auto
TGADS_CLAUDE_BIN=claude
TGADS_CLAUDE_MODEL=opus
# Only for TGADS_AI_MODE=api
TGADS_ANTHROPIC_API_KEY=

TGADS_DATA_DIR=data
